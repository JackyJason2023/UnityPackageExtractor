<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UnityPackageExtractor</RootNamespace>
    <AssemblyName>UnityPackageExtractor</AssemblyName>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 声明最低支持的 Windows 版本，消除 WinForms API 的 CA1416 平台兼容性警告 -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <!-- 用 API 方式配置 DPI（替代 manifest 中的高 DPI 节点），消除 WFAC010 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 保留项目自带的 AssemblyInfo.cs，避免与 SDK 自动生成的程序集特性重复 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- resx 资源任务使用当前架构/运行时，避免任务宿主问题 -->
    <GenerateResourceMSBuildArchitecture>CurrentArchitecture</GenerateResourceMSBuildArchitecture>
    <GenerateResourceMSBuildRuntime>CurrentRuntime</GenerateResourceMSBuildRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- Settings.Designer.cs 依赖 .NET Framework 专有的 System.Configuration.ApplicationSettingsBase，
       项目代码并未使用 Settings，故从编译中排除 -->
  <ItemGroup>
    <Compile Remove="Properties\Settings.Designer.cs" />
  </ItemGroup>

</Project>
